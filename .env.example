# Copy to .env. Choose one provider and paste only its API key. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local API access key for /rewrite and administrative endpoints.
# Change this before exposing the server beyond your own machine.
ADMIN_API_KEY=change-this-local-api-key
SECRET_KEY=change-this-local-secret

API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
POLICY_CONFIG_PATH=./config/policies.yaml
